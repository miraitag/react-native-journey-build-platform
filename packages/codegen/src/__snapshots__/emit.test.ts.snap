{
  ".npmrc": "minimumReleaseAge=1440
blockExoticSubdeps=true
",
  "package.json": "{
  "name": "react-native-journey-basico",
  "version": "0.1.0",
  "main": "src/index.tsx",
  "packageManager": "pnpm@11.2.2",
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {
    "@react-navigation/native": "*",
    "@react-navigation/native-stack": "*",
