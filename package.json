{
  "name": "rn-journey-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@rnjb/web --filter=@rnjb/local-service",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:root",
    "format": "prettier . --write --cache",
    "format:check": "prettier . --check --cache",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:perf": "pnpm fixtures && RNJB_PERF=1 vitest run && pnpm --filter @rnjb/web test:perf",
    "fixtures": "tsx scripts/generate-journey-50.ts",
    "check:exports": "tsx scripts/check-reference-export.ts",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "prepare": "lefthook install || true",
    "lint:root": "eslint scripts \"*.{js,ts}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@rnjb/codegen": "workspace:*",
    "@rnjb/core": "workspace:*",
    "@rnjb/document-schema": "workspace:*",
    "@rnjb/profiles": "workspace:*",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
