# ---------------------------------------------------------------
# Plataforma RN Journey Builder
# ---------------------------------------------------------------
# Caché local de miniaturas, índice, bundles web y clones remotos
.rnjb-cache/
# Fixture de rendimiento generado con `pnpm fixtures` (6+ MB)
fixtures/journey-50/
# Espacio de trabajo y home de demostración para probar la plataforma en local
fixtures/demo-workspace/
fixtures/demo-home/
# Configuración local por máquina (rutas y fuentes); no se versiona
rnjb.local.json
settings.local.json

